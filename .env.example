# ResearchNexus configuration -- a template with NO real values.
#
# Copy to `.env` (git-ignored) for docker compose, or set these as the
# containers' environment / AWS Secrets Manager entries in a deployment.
# Every variable is described in ENVIRONMENT_VARIABLES.md. Never commit a
# filled-in copy, and never put a secret in a NEXT_PUBLIC_* variable (those
# are compiled into the browser bundle).
#
# Local development with `python start.py` needs none of this: it writes
# backend/.env with generated local secrets on first run.

# --- docker compose only ------------------------------------------------------
# password for the compose PostgreSQL container (any long random string)
POSTGRES_PASSWORD=

# --- required everywhere ----------------------------------------------------------
# development | test | staging | production   (unset = production: fails closed)
RESEARCHNEXUS_ENVIRONMENT=production
# >= 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
RESEARCHNEXUS_SECRET_KEY=
# a Fernet key; encrypts saved LLM keys -- keep it stable, or saved keys become unreadable:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESEARCHNEXUS_KEY_VAULT_SECRET=

# --- database --------------------------------------------------------------------------
# PostgreSQL in staging/production (SQLite is for development only)
RESEARCHNEXUS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/researchnexus
RESEARCHNEXUS_DB_POOL_SIZE=5
RESEARCHNEXUS_DB_MAX_OVERFLOW=5
RESEARCHNEXUS_DB_POOL_TIMEOUT_S=10
RESEARCHNEXUS_DB_POOL_RECYCLE_S=1800
# create missing tables at start: leave false outside development (migrations change the schema)
RESEARCHNEXUS_DB_AUTO_CREATE=false

# --- addresses ---------------------------------------------------------------------------
# where people open the app (used in emails and as the allowed origin)
RESEARCHNEXUS_PUBLIC_APP_URL=https://researchnexus.example.org
# JSON list of origins allowed to call the API from a browser
RESEARCHNEXUS_CORS_ALLOWED_ORIGINS=["https://researchnexus.example.org"]

# --- sessions and sign-in codes ---------------------------------------------------------------
RESEARCHNEXUS_SESSION_MAX_AGE_HOURS=336
RESEARCHNEXUS_SESSION_IDLE_HOURS=72
# leave unset: Secure everywhere but development/test
# RESEARCHNEXUS_COOKIE_SECURE=
RESEARCHNEXUS_OTP_TTL_SECONDS=300
RESEARCHNEXUS_OTP_MAX_ATTEMPTS=5
RESEARCHNEXUS_OTP_RESEND_COOLDOWN_SECONDS=60
RESEARCHNEXUS_OTP_MAX_RESENDS=3

# --- email (Amazon SES SMTP interface in production) ---------------------------------------
RESEARCHNEXUS_EMAIL_BACKEND=smtp
RESEARCHNEXUS_EMAIL_FROM=ResearchNexus <no-reply@your-verified-domain.example>
RESEARCHNEXUS_SMTP_HOST=email-smtp.REGION.amazonaws.com
RESEARCHNEXUS_SMTP_PORT=587
RESEARCHNEXUS_SMTP_USERNAME=
RESEARCHNEXUS_SMTP_PASSWORD=
RESEARCHNEXUS_SMTP_STARTTLS=true

# --- scholarly sources (all optional; everything works without keys) -------------------------
# an address the sources may contact about this app's traffic (faster "polite" access; enables Unpaywall)
RESEARCHNEXUS_CONTACT_EMAIL=
RESEARCHNEXUS_OPENALEX_API_KEY=
RESEARCHNEXUS_SEMANTIC_SCHOLAR_API_KEY=
RESEARCHNEXUS_CORE_API_KEY=

# --- full text and uploads ---------------------------------------------------------------
RESEARCHNEXUS_DATA_DIR=/data
RESEARCHNEXUS_MAX_PDF_MB=30
RESEARCHNEXUS_MAX_PAGES=60
RESEARCHNEXUS_FULLTEXT_TIMEOUT_S=30
RESEARCHNEXUS_FULLTEXT_CONCURRENCY=3

# --- CPU-heavy work ------------------------------------------------------------------------
# threads for the embedding model (unset = all cores)
RESEARCHNEXUS_EMBEDDING_THREADS=2
# set by the container image; only change it to move the baked-in model
# RESEARCHNEXUS_MODELS_DIR=/opt/models

# --- language models (users bring their own keys in Settings; nothing to set here) ------
# optional per-provider model override, e.g. {"deepseek": "deepseek-chat"}
# RESEARCHNEXUS_LLM_MODELS={}

# --- logging -------------------------------------------------------------------------------
RESEARCHNEXUS_LOG_LEVEL=INFO

# --- frontend (build time; public, never a secret) -----------------------------------------
# empty: the browser calls the API on the app's own address under /api (the AWS setup)
NEXT_PUBLIC_API_BASE_URL=
